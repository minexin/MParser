* text=auto

*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
*.cmake.in text eol=lf
*.json text eol=lf
*.md text eol=lf
*.m text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
SHA256SUMS text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.gz binary

# Preserve signed release evidence byte-for-byte so hashes and signatures remain valid.
docs/release-evidence/** -text -whitespace
