{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MPARSER_ENABLE_NATIVE_JIT": "ON",
        "MPARSER_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc-asan-nojit",
      "displayName": "Windows MSVC ASan no-JIT",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-asan-nojit-v1",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MPARSER_ENABLE_NATIVE_JIT": "OFF",
        "MPARSER_ENABLE_MSVC_ASAN": "ON",
        "MPARSER_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc-release-nojit",
      "displayName": "Windows MSVC Release no-JIT",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-release-nojit",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MPARSER_ENABLE_NATIVE_JIT": "OFF",
        "MPARSER_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MPARSER_ENABLE_NATIVE_JIT": "ON",
        "MPARSER_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "windows-msvc-asan-nojit",
      "configurePreset": "windows-msvc-asan-nojit"
    },
    {
      "name": "windows-msvc-release-nojit",
      "configurePreset": "windows-msvc-release-nojit"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-asan-nojit",
      "configurePreset": "windows-msvc-asan-nojit",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release-nojit",
      "configurePreset": "windows-msvc-release-nojit",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
