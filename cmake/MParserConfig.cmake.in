@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/MParserTargets.cmake")

set(MParser_VERSION "@PROJECT_VERSION@")
set(MParser_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(MParser_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(MParser_VERSION_PATCH "@PROJECT_VERSION_PATCH@")
set(MParser_C_API_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(MParser_C_API_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(MParser_C_API_VERSION_PATCH "@PROJECT_VERSION_PATCH@")
set(MParser_C_ABI_GENERATION "@MPARSER_C_ABI_GENERATION@")
set(MParser_C_ABI_REVISION "@MPARSER_C_ABI_REVISION@")
set(MParser_CPP_API_VERSION_MAJOR "1")
set(MParser_CPP_API_VERSION_MINOR "2")
set(MParser_CLI_CONTRACT_MAJOR "1")
set(MParser_CLI_CONTRACT_MINOR "0")
set(MParser_MACHINE_PROTOCOL_NAME "mparser.result")
set(MParser_MACHINE_PROTOCOL_MAJOR "1")
set(MParser_MACHINE_PROTOCOL_MINOR "1")
set(MParser_BUILTIN_SOURCE_CONTRACT_MAJOR "1")
set(MParser_BUILTIN_SOURCE_CONTRACT_MINOR "3")
set(MParser_LICENSE "@MPARSER_PROJECT_LICENSE@")
set(MParser_COPYRIGHT "@MPARSER_PROJECT_COPYRIGHT@")
set(MParser_C_FOUND TRUE)
set(MParser_CPP_FOUND TRUE)
set(MParser_CLI_FOUND TRUE)
set_and_check(
    MParser_C_INCLUDE_DIR
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(MParser_CPP_INCLUDE_DIR "${MParser_C_INCLUDE_DIR}")
set_and_check(
    MParser_CLI_DIR
    "@PACKAGE_CMAKE_INSTALL_BINDIR@")
set_and_check(
    MParser_LICENSE_FILE
    "@PACKAGE_CMAKE_INSTALL_DOCDIR@/LICENSE")
set_and_check(
    MParser_NOTICE_FILE
    "@PACKAGE_CMAKE_INSTALL_DOCDIR@/NOTICE")
set_and_check(
    MParser_THIRD_PARTY_NOTICES_FILE
    "@PACKAGE_CMAKE_INSTALL_DOCDIR@/THIRD_PARTY_NOTICES.md")
set_and_check(
    MParser_PUBLIC_CONTRACT_FILE
    "@PACKAGE_CMAKE_INSTALL_DOCDIR@/public-contract-v1.2.json")
set_and_check(
    MParser_CLI_CONTRACT_FILE
    "@PACKAGE_CMAKE_INSTALL_DOCDIR@/cli-contract-v1.json")
set_and_check(
    MParser_MACHINE_PROTOCOL_SCHEMA_FILE
    "@PACKAGE_CMAKE_INSTALL_DOCDIR@/machine-result-v1.schema.json")
set_and_check(
    MParser_BUILTIN_CATALOG_FILE
    "@PACKAGE_CMAKE_INSTALL_DOCDIR@/default_catalog.json")
set_and_check(
    MParser_BUILTIN_EXTENSION_GUIDE_FILE
    "@PACKAGE_CMAKE_INSTALL_DOCDIR@/extending-builtins.md")
set_and_check(
    MParser_VERSIONING_POLICY_FILE
    "@PACKAGE_CMAKE_INSTALL_DOCDIR@/versioning-and-deprecation.md")

check_required_components(MParser)
