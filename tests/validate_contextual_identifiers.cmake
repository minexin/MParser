cmake_minimum_required(VERSION 3.20)
foreach(required IN ITEMS MPARSER_EXECUTABLE MPARSER_CORPUS MPARSER_TEST_ROOT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
file(READ "${MPARSER_CORPUS}" corpus)
string(JSON name_count LENGTH "${corpus}" names)
string(JSON case_count LENGTH "${corpus}" cases)
math(EXPR name_last "${name_count} - 1")
math(EXPR case_last "${case_count} - 1")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(root "${MPARSER_TEST_ROOT}/${run_id}")
file(MAKE_DIRECTORY "${root}")
file(SHA256 "${MPARSER_EXECUTABLE}" binary_sha256)
file(SHA256 "${MPARSER_CORPUS}" corpus_sha256)
file(WRITE "${root}/inputs.txt" "binary_sha256=${binary_sha256}\ncorpus_sha256=${corpus_sha256}\n")
set(passed 0)
set(failed 0)
foreach(case_index RANGE ${case_last})
    string(JSON case_id GET "${corpus}" cases ${case_index} id)
    string(JSON expected GET "${corpus}" cases ${case_index} expected)
    string(JSON source_template GET "${corpus}" cases ${case_index} source)
    string(JSON class_template ERROR_VARIABLE no_class GET "${corpus}" cases ${case_index} class_source)
    foreach(name_index RANGE ${name_last})
        string(JSON name GET "${corpus}" names ${name_index})
        string(JSON expected_error ERROR_VARIABLE no_rejection GET "${corpus}"
            cases ${case_index} expected_rejections "${name}")
        set(directory "${root}/${case_id}_${name}")
        file(MAKE_DIRECTORY "${directory}")
        set(class_name "Contextual_${case_id}_${name}")
        string(REPLACE "@NAME@" "${name}" source "${source_template}")
        string(REPLACE "@CLASS@" "${class_name}" source "${source}")
        set(file "${directory}/${case_id}_${name}.m")
        file(WRITE "${file}" "${source}")
        if(NOT no_class)
            string(REPLACE "@NAME@" "${name}" class_source "${class_template}")
            string(REPLACE "@CLASS@" "${class_name}" class_source "${class_source}")
            file(WRITE "${directory}/${class_name}.m" "${class_source}")
        endif()
        foreach(backend IN ITEMS off portable native auto)
            execute_process(COMMAND "${MPARSER_EXECUTABLE}" --run "--jit=${backend}"
                --result-format=json-v1 "--path=${directory}" "${file}"
                RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 15)
            file(WRITE "${directory}/${backend}.json" "${output}")
            file(WRITE "${directory}/${backend}.log" "exit=${status}\n${error}")
            set(ok FALSE)
            string(JSON invocation_status ERROR_VARIABLE json_error GET "${output}" status)
            if(NOT json_error)
                if(NOT no_rejection AND status EQUAL 1 AND invocation_status STREQUAL "compilation-failed")
                    string(JSON identifier GET "${output}" diagnostics 0 identifier)
                    string(JSON phase GET "${output}" diagnostics 0 phase)
                    string(JSON variable_count LENGTH "${output}" workspace)
                    string(JSON event_count LENGTH "${output}" output_events)
                    string(JSON instructions GET "${output}" execution executed_instruction_count)
                    if(identifier STREQUAL "MParser:CompilationFailed" AND phase STREQUAL "compilation" AND
                       variable_count EQUAL 0 AND event_count EQUAL 0 AND instructions EQUAL 0)
                        set(ok TRUE)
                    endif()
                elseif(no_rejection AND status EQUAL 0 AND invocation_status STREQUAL "succeeded")
                    string(JSON diagnostic_count LENGTH "${output}" diagnostics)
                    string(JSON count LENGTH "${output}" workspace)
                    if(count GREATER 0)
                        math(EXPR last "${count} - 1")
                        foreach(index RANGE ${last})
                            string(JSON variable_name GET "${output}" workspace ${index} name)
                            if(variable_name STREQUAL "result")
                                string(JSON kind GET "${output}" workspace ${index} value kind)
                                string(JSON class GET "${output}" workspace ${index} value class)
                                string(JSON size LENGTH "${output}" workspace ${index} value data)
                                string(JSON actual GET "${output}" workspace ${index} value data 0)
                                string(JSON rank LENGTH "${output}" workspace ${index} value dimensions)
                                string(JSON rows GET "${output}" workspace ${index} value dimensions 0)
                                string(JSON columns GET "${output}" workspace ${index} value dimensions 1)
                                if(kind STREQUAL "numeric" AND class STREQUAL "double" AND
                                   size EQUAL 1 AND actual EQUAL expected AND diagnostic_count EQUAL 0 AND
                                   rank EQUAL 2 AND rows EQUAL 1 AND columns EQUAL 1)
                                    set(ok TRUE)
                                endif()
                            endif()
                        endforeach()
                    endif()
                endif()
            endif()
            if(ok)
                math(EXPR passed "${passed} + 1")
            else()
                math(EXPR failed "${failed} + 1")
                message(STATUS "FAIL ${case_id}/${name}/${backend}; see ${directory}")
            endif()
        endforeach()
    endforeach()
endforeach()
message(STATUS "Contextual identifiers: ${passed} passed, ${failed} failed; evidence ${root}")
file(WRITE "${root}/summary.txt" "passed=${passed}\nfailed=${failed}\n")
if(failed GREATER 0 AND NOT MPARSER_PROBE_ALLOW_FAILURES)
    message(FATAL_ERROR "Contextual identifier regression failed")
endif()
