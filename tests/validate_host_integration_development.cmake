cmake_minimum_required(VERSION 3.20)
file(READ "${PROJECT_ROOT}/docs/host-integration-contract-development.json" manifest)
string(JSON product_version GET "${manifest}" release engine_version)
if(DEFINED EXPECTED_VERSION AND NOT product_version STREQUAL EXPECTED_VERSION)
    message(FATAL_ERROR "Development product version disagrees with the project")
endif()
string(JSON release_state GET "${manifest}" release state)
if(NOT release_state STREQUAL "development")
    message(FATAL_ERROR "Development manifest must not claim a frozen or published release")
endif()
string(JSON count LENGTH "${manifest}" artifacts)
math(EXPR last "${count} - 1")
foreach(i RANGE 0 ${last})
    string(JSON path GET "${manifest}" artifacts ${i} path)
    string(JSON expected GET "${manifest}" artifacts ${i} sha256_lf)
    file(READ "${PROJECT_ROOT}/${path}" contents)
    string(REPLACE "\r\n" "\n" contents "${contents}")
    string(REPLACE "\r" "\n" contents "${contents}")
    string(SHA256 actual "${contents}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Development artifact mismatch: ${path}")
    endif()
endforeach()
string(JSON revision GET "${manifest}" c_abi revision)
string(JSON expected_symbols GET "${manifest}" c_abi symbol_count)
file(STRINGS "${PROJECT_ROOT}/tests/c_api_generation2_revision${revision}_symbols.txt" symbols)
list(REMOVE_DUPLICATES symbols)
list(LENGTH symbols actual_symbols)
if(NOT actual_symbols EQUAL expected_symbols)
    message(FATAL_ERROR "Development ABI symbol count mismatch")
endif()
file(READ "${PROJECT_ROOT}/include/mparser/c_api.h" header)
set(source_version_parts)
foreach(field IN ITEMS major minor patch)
    string(TOUPPER "${field}" macro)
    string(JSON declared GET "${manifest}" source_api ${field})
    list(APPEND source_version_parts "${declared}")
    if(NOT header MATCHES "#define MPARSER_C_API_VERSION_${macro} +${declared}u")
        message(FATAL_ERROR "Development source API ${field} disagrees with header")
    endif()
endforeach()
list(JOIN source_version_parts "." source_version)
if(NOT source_version STREQUAL product_version)
    message(FATAL_ERROR "Development source API version differs from product identity")
endif()
foreach(field IN ITEMS generation revision)
    string(TOUPPER "${field}" macro)
    string(JSON declared GET "${manifest}" c_abi ${field})
    if(NOT header MATCHES "#define MPARSER_C_ABI_${macro} +${declared}u")
        message(FATAL_ERROR "Development ABI ${field} disagrees with header")
    endif()
endforeach()
string(JSON major GET "${manifest}" builtin_source_contract major)
string(JSON minor GET "${manifest}" builtin_source_contract minor)
file(READ "${PROJECT_ROOT}/tests/public_contract/builtin/${major}.${minor}/default_catalog.json" catalog)
string(JSON descriptor_count LENGTH "${catalog}" descriptors)
string(JSON catalog_count GET "${catalog}" descriptor_count)
string(JSON expected_count GET "${manifest}" builtin_source_contract descriptor_count)
if(NOT descriptor_count EQUAL expected_count OR NOT catalog_count EQUAL expected_count)
    message(FATAL_ERROR "Development descriptor count disagrees with catalog")
endif()
set(names ${descriptor_count})
math(EXPR last_descriptor "${descriptor_count} - 1")
foreach(i RANGE 0 ${last_descriptor})
    string(JSON aliases LENGTH "${catalog}" descriptors ${i} aliases)
    math(EXPR names "${names} + ${aliases}")
endforeach()
string(JSON expected_names GET "${manifest}" builtin_source_contract registered_name_count)
if(NOT names EQUAL expected_names)
    message(FATAL_ERROR "Development registered name count disagrees with catalog")
endif()
file(READ "${PROJECT_ROOT}/docs/graphics-v3.schema.json" graphics_schema)
string(JSON schema_version GET "${graphics_schema}" properties version const)
string(JSON declared_version GET "${manifest}" graphics opt_in_version)
if(NOT schema_version EQUAL declared_version)
    message(FATAL_ERROR "Development graphics version disagrees with schema")
endif()
message(STATUS "Validated ${count} host integration development artifacts and ${actual_symbols} ABI symbols")
