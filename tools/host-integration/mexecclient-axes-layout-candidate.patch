index 0000000..7f711f4
--- /dev/null
+++ b/web/js/plot-layout.js
@@ -0,0 +1,111 @@
+window.MExec = window.MExec || {};
+MExec.plotLayout = (() => {
+  const positive = value => Number.isFinite(value) && value > 0;
+  const fields = ['width_pixels','height_pixels','pixels_per_inch',
+    'character_width_pixels','character_height_pixels'];
+  function metrics(layout) {
+    if (!layout) return null;
+    const values = [...(layout.contentSizePixels || []),layout.pixelsPerInch,
+      ...(layout.characterSizePixels || [])];
+    return values.length === 5 && values.every(positive)
+      ? Object.fromEntries(fields.map((field,index) => [field,values[index]])) : null;
+  }
+  function frame(properties, layout, width, height) {
+    const p = properties?.Position, units = properties?.Units;
+    if (!positive(width) || !positive(height) || !Array.isArray(p) || p.length !== 4 ||
+        !p.every(Number.isFinite) || p[2] < 0 || p[3] < 0) return null;
+    let sx, sy, origin = 0;
+    if (units === 'normalized') { sx = width; sy = height; }
+    else {
+      const environment = metrics(layout);
+      if (!environment) return null;
+      const dpi = environment.pixels_per_inch;
+      if (units === 'pixels') { sx = sy = 1; origin = 1; }
+      else if (units === 'inches') sx = sy = dpi;
+      else if (units === 'centimeters') sx = sy = dpi / 2.54;
+      else if (units === 'points') sx = sy = dpi / 72;
+      else if (units === 'characters') {
+        sx = environment.character_width_pixels; sy = environment.character_height_pixels;
+      } else return null;
+    }
+    const left = (p[0] - origin) * sx, bottom = (p[1] - origin) * sy;
+    const result = {left,top:height-bottom-p[3]*sy,width:p[2]*sx,height:p[3]*sy};
+    return Object.values(result).every(Number.isFinite) ? result : null;
+  }
+  function measure(element) {
+    if (!element?.isConnected || !element.getClientRects().length ||
+        document.fonts?.status === 'loading') return null;
+    const style = window.getComputedStyle(element);
+    if (style.visibility !== 'visible' || !style.font) return null;
+    const size = ['width','height'].map((name,index) => {
+      const axis = index ? ['Top','Bottom'] : ['Left','Right'];
+      return (index ? element.clientHeight : element.clientWidth) -
+        axis.reduce((total,side) => total + (parseFloat(style['padding'+side]) || 0),0);
+    });
+    if (!size.every(positive)) return null;
+    const ruler = document.createElement('span'), characters = document.createElement('span');
+    ruler.style.cssText = 'position:fixed;left:0;top:0;width:1in;height:1px;padding:0;border:0;visibility:hidden;pointer-events:none;';
+    characters.style.cssText = 'position:fixed;left:0;top:0;width:max-content;height:auto;padding:0;border:0;visibility:hidden;pointer-events:none;white-space:pre;letter-spacing:0;';
+    characters.style.font = style.font;
+    characters.textContent = '0000000000';
+    try {
+      document.body.appendChild(ruler); document.body.appendChild(characters);
+      const box = characters.getBoundingClientRect();
+      const values = [...size,ruler.getBoundingClientRect().width,box.width/10,box.height];
+      return values.every(positive) ? Object.fromEntries(fields.map((field,index) => [field,values[index]])) : null;
+    } finally { ruler.remove(); characters.remove(); }
+  }
+  function same(layout, environment) {
+    const previous = metrics(layout);
+    return previous && fields.every(field => previous[field] === environment[field]);
+  }
+  function controller({api,current,render,target,measure:readMetrics,onCommit = () => {}}) {
+    let pending = null, again = false;
+    async function run() {
+      const owner = current();
+      if (!owner?.enabled || !owner.sessionId) return;
+      const live = () => {
+        const value = current();
+        return value?.enabled && value.sessionId === owner.sessionId && value.epoch === owner.epoch;
+      };
+      let response;
+      try { response = await api.graphicsLayout(owner.sessionId); }
+      catch (error) { if (error.status === 409 || !live()) return; throw error; }
+      if (!live()) return;
+      render(response.graphics);
+      const selected = target(), environment = readMetrics();
+      const graph = response.graphics;
+      const figure = graph?.objects?.find(item => item.type === 'Figure' && item.objectIdentity === selected?.figure_identity);
+      if (!figure || selected.graph_identity !== graph.graphIdentity || !environment ||
+          !fields.every(field => positive(environment[field])) || same(figure.layout,environment)) return;
+      if (typeof response.revision !== 'string') throw new Error('Missing layout workspace revision');
+      try {
+        response = await api.graphicsLayoutEnvironment(owner.sessionId,{
+          graph_identity:graph.graphIdentity,figure_identity:figure.objectIdentity,
+          expected_revision:response.revision,environment,
+        });
+      } catch (error) {
+        // A lost response may follow a committed write. Read before any retry.
+        if (live()) {
+          try {
+            const fresh = await api.graphicsLayout(owner.sessionId);
+            if (live()) { render(fresh.graphics); await onCommit(); }
+          } catch (_) {}
+        }
+        if (error.status === 409 || !live()) return;
+        throw error;
+      }
+      if (!live()) return;
+      render(response.graphics); await onCommit();
+    }
+    function refresh() {
+      if (pending) { again = true; return pending; }
+      pending = (async () => {
+        do { again = false; await run(); } while (again);
+      })().finally(() => { pending = null; });
+      return pending;
+    }
+    return {refresh};
+  }
+  return {frame,measure,metrics,controller};
+})();
