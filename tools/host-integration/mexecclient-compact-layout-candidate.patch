diff --git a/web/css/mexec.css b/web/css/mexec.css
index c87656c..e8dd8ed 100644
--- a/web/css/mexec.css
+++ b/web/css/mexec.css
@@ -816,0 +817,48 @@ button:focus-visible {outline:2px solid var(--accent);outline-offset:-2px;}
+
+#compact-panel-tabs {display:flex;flex:none;gap:0;border-bottom:1px solid var(--border);background:#f5f6f7;}
+#compact-panel-tabs[hidden] {display:none;}
+#compact-panel-tabs button {flex:1;min-width:0;border:0;border-bottom:2px solid transparent;border-radius:0;padding:5px 3px;letter-spacing:0;}
+#compact-panel-tabs button[aria-selected=true] {border-bottom-color:var(--accent);background:#fff;color:#064875;}
+#main.compact-layout {min-width:0;width:100%;max-width:100%;grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(0,1fr) minmax(88px,var(--command-height));}
+#main.compact-layout > .splitter,#main.compact-layout > .compact-pane-concealed {display:none;}
+#main.compact-layout #center-panel {grid-column:1;grid-row:1;}
+#main.compact-layout #command-panel {grid-column:1;grid-row:2;}
+#main.compact-layout #files-panel,#main.compact-layout #right-panel,
+#main.compact-layout[data-compact-pane=command-panel] #command-panel {grid-column:1;grid-row:1 / -1;}
+#main.compact-layout.compact-short {grid-template-rows:minmax(0,1fr);}
+#main.compact-layout .panel-maximize {display:none;}
+.plot-toolbar {display:flex;flex-wrap:wrap;align-items:center;gap:5px;flex:none;}
+.plot-toolbar label {display:flex;align-items:center;gap:4px;min-width:0;max-width:100%;}
+.plot-toolbar select {min-width:0;max-width:180px;}
+
+@media (max-width:720px), (max-height:500px) and (max-width:1000px) {
+  body {overflow-x:hidden;}
+  #ribbon,#menubar,#directory-bar {min-width:0;max-width:100%;flex-shrink:0;}
+  #menubar {display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) 28px;}
+  #ribbon-tabs {grid-column:1 / 5;grid-row:1;margin:0;min-width:0;}
+  #ribbon-tabs button {flex:1;min-width:0;padding:5px 3px;}
+  #ribbon-toggle {grid-column:5;grid-row:1;margin-left:0;}
+  #menubar .menu {grid-row:2;min-width:0;}
+  #menubar .menu-trigger {width:100%;}
+  #menubar .menu-items {width:180px;min-width:0;max-width:calc(100vw - 12px);}
+  #menubar [data-menu=view] .menu-items,#menubar [data-menu=help] .menu-items {right:0;left:auto;}
+  #directory-bar {display:grid;grid-template-columns:repeat(4,28px) minmax(0,1fr) 28px;gap:3px;}
+  #directory-bar > label {display:none;}
+  #directory-location {grid-row:2;grid-column:1 / -1;}
+  #files-history {grid-column:5;grid-row:1;width:100%;min-width:0;max-width:none;}
+  #files-edit-path {grid-column:6;grid-row:1;}
+  #statusbar {min-width:0;}
+}
+@media (max-height:500px) and (max-width:1000px) {
+  #menubar {display:flex;flex-wrap:nowrap;min-height:28px;}
+  #menubar #ribbon-tabs {flex:1;margin:0;}
+  #menubar .menu > .menu-trigger {padding:5px;}
+  #menubar .session-label {display:none;}
+  #ribbon {height:65px;min-height:65px;}
+  #ribbon .ribbon-actions button {height:42px;}
+  #ribbon .ribbon-files .ribbon-actions button:nth-child(n+4),#ribbon .ribbon-edit .ribbon-actions button {height:13px;}
+  #ribbon .ribbon-files .ribbon-actions,#ribbon .ribbon-edit .ribbon-actions {grid-template-rows:repeat(3,13px);}
+  #directory-bar {display:flex;flex-wrap:nowrap;}
+  #directory-location {min-width:0;}
+  #files-history {width:100px;max-width:20%;}
+}
