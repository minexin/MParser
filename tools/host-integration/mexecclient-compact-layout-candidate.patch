index 2b3045a..e307628 100644
--- a/web/js/layout.js
+++ b/web/js/layout.js
@@ -73,0 +74,3 @@ window.MExec = window.MExec || {};
+  let compactActive = false;
+  let syncCompact = () => {};
+  let revealCompact = () => {};
@@ -75,0 +79 @@ window.MExec = window.MExec || {};
+    if (compactActive && panel) return;
@@ -88,0 +93 @@ window.MExec = window.MExec || {};
+    syncCompact();
@@ -117 +122,4 @@ window.MExec = window.MExec || {};
-  MExec.layout = {reveal(id) { if (maximized && maximized.element.id !== id) setMaximized(null); }};
+  MExec.layout = {reveal(id) {
+    if (maximized && maximized.element.id !== id) setMaximized(null);
+    revealCompact(id);
+  }};
@@ -118,0 +127,78 @@ window.MExec = window.MExec || {};
+
+  const navigation = document.getElementById('compact-panel-tabs');
+  if (!navigation || !window.matchMedia) return;
+  const compactMedia = window.matchMedia('(max-width: 720px), (max-height: 500px) and (max-width: 1000px)');
+  const shortMedia = window.matchMedia('(max-height: 500px)');
+  const choices = [...navigation.querySelectorAll('[data-panel]')];
+  const panelRoles = new Map(panels.map(panel => [panel.element.id,{
+    role:panel.element.getAttribute('role'),label:panel.element.getAttribute('aria-labelledby'),
+  }]));
+  let compactPane = 'workbench';
+  syncCompact = () => {
+    const active = document.activeElement;
+    const navigationHadFocus = navigation.contains(active);
+    navigation.hidden = !compactActive;
+    main.classList.toggle('compact-layout',compactActive);
+    main.classList.toggle('compact-short',compactActive && shortMedia.matches);
+    main.dataset.compactPane = compactPane;
+    const visible = compactPane === 'workbench'
+      ? ['center-panel',...(shortMedia.matches ? [] : ['command-panel'])] : [compactPane];
+    let concealedFocus = false;
+    for (const panel of panels) {
+      const concealed = compactActive && !visible.includes(panel.element.id);
+      concealedFocus ||= concealed && panel.element.contains(active);
+      panel.element.classList.toggle('compact-pane-concealed',concealed);
+      panel.element.inert = concealed || Boolean(maximized && panel !== maximized);
+      if (compactActive) {
+        const owner = panel.element.id === 'center-panel' || (panel.element.id === 'command-panel' && compactPane === 'workbench')
+          ? 'workbench' : panel.element.id;
+        panel.element.setAttribute('role','tabpanel');
+        panel.element.setAttribute('aria-labelledby',choices.find(choice => choice.dataset.panel === owner).id);
+      } else {
+        const previous = panelRoles.get(panel.element.id);
+        for (const [name,value] of [['role',previous.role],['aria-labelledby',previous.label]]) {
+          if (value === null) panel.element.removeAttribute(name);
+          else panel.element.setAttribute(name,value);
+        }
+      }
+    }
+    for (const choice of choices) {
+      const selected = choice.dataset.panel === compactPane;
+      choice.setAttribute('aria-selected',String(selected));
+      choice.tabIndex = selected ? 0 : -1;
+      if (selected && concealedFocus) choice.focus();
+    }
+    if (!compactActive && navigationHadFocus) {
+      document.querySelector('.center-view-tabs [aria-selected="true"]')?.focus();
+    }
+    MExec.plot.draw();
+  };
+  function choose(value, focus = false) {
+    if (!choices.some(choice => choice.dataset.panel === value)) return;
+    compactPane = value; syncCompact();
+    if (focus) choices.find(choice => choice.dataset.panel === value).focus();
+  }
+  revealCompact = id => {
+    if (compactActive) choose(id === 'center-panel' ? 'workbench' : id);
+  };
+  choices.forEach((choice,index) => {
+    choice.addEventListener('click',() => choose(choice.dataset.panel));
+    choice.addEventListener('keydown',event => {
+      if (event.defaultPrevented || event.isComposing || event.keyCode === 229 ||
+          event.ctrlKey || event.altKey || event.metaKey || event.shiftKey) return;
+      const next = event.key === 'ArrowRight' ? (index+1)%choices.length :
+        event.key === 'ArrowLeft' ? (index+choices.length-1)%choices.length :
+        event.key === 'Home' ? 0 : event.key === 'End' ? choices.length-1 : null;
+      if (next === null) return;
+      event.preventDefault(); choose(choices[next].dataset.panel,true);
+    });
+  });
+  const updateMode = () => {
+    compactActive = compactMedia.matches;
+    if (compactActive && maximized) setMaximized(null);
+    syncCompact();
+  };
+  compactMedia.addEventListener('change',updateMode);
+  shortMedia.addEventListener('change',syncCompact);
+  document.getElementById('layout-reset').addEventListener('click',() => choose('workbench'));
+  updateMode();
