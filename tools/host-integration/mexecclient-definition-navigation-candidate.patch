index 0000000..4b88456
--- /dev/null
+++ b/web/js/definition-directory.js
@@ -0,0 +1,82 @@
+window.MExec = window.MExec || {};
+MExec.definitionDirectory = (() => {
+  const kinds = new Set(['primary-function','local-function','nested-function','method']);
+  const integer = value => Number.isSafeInteger(value) && value >= 0;
+  function positions(source,content,offsets) {
+    if(typeof source!=='string' || source.replace(/\r\n?/g,'\n')!==content)throw Error('source text mismatch');
+    const encoder=new TextEncoder(),result=new Map();
+    let index=0,offset=0,editor=0,line=1,column=1;
+    while(true){
+      if(offsets.has(offset))result.set(offset,{editor,line,column});
+      if(index===source.length)break;
+      const point=source.codePointAt(index);
+      if(point>=0xd800 && point<=0xdfff)throw Error('unpaired UTF-16 surrogate');
+      const token=source[index]==='\r' && source[index+1]==='\n' ? '\r\n' : String.fromCodePoint(point);
+      const bytes=encoder.encode(token).length;
+      index+=token.length;offset+=bytes;
+      if(token==='\n' || token[0]==='\r'){editor++;line++;column=1;}
+      else {editor+=token.length;column+=bytes;}
+    }
+    if(result.size!==offsets.size)throw Error('offset is not a UTF-8/line-ending boundary');
+    return result;
+  }
+  function read(directory,documents) {
+    if(!directory || directory.schema!=='mexec.definition-directory' || directory.version!==1 ||
+      directory.complete!==true || directory.offset_unit!=='utf8-byte' || directory.column_unit!=='utf8-byte' ||
+      directory.line_base!==1 || directory.column_base!==1 || directory.end_exclusive!==true ||
+      !Array.isArray(directory.definitions) || !Array.isArray(documents) || !documents.length)
+      throw Error('unsupported or incomplete definition directory');
+    const sources=directory.sources || [{name:directory.source_name,source_utf8:directory.source_utf8}];
+    if(!Array.isArray(sources) || sources.length!==documents.length ||
+      directory.source_name!==documents[0].sourceName || directory.source_utf8!==documents[0].source)
+      throw Error('submitted source identity mismatch');
+    const names=new Set(),targets=documents.map(()=>new Set());
+    sources.forEach((source,index)=>{
+      const document=documents[index];
+      if(!source || source.name!==document.sourceName || source.source_utf8!==document.source ||
+        (source.class_method_owner || '')!==(document.classMethodOwner || '') || names.has(source.name))
+        throw Error('submitted source graph mismatch');
+      names.add(source.name);
+    });
+    const definitions=directory.definitions;
+    definitions.forEach((entry,index)=>{
+      if(!entry || entry.index!==index || typeof entry.name!=='string' || !entry.name ||
+        !kinds.has(entry.kind) || typeof entry.class_name!=='string' || typeof entry.declaration_only!=='boolean' ||
+        !integer(entry.source_index) || entry.source_index>=documents.length ||
+        !(entry.parent_function===null || (integer(entry.parent_function) && entry.parent_function<definitions.length && entry.parent_function!==index)) ||
+        entry.source?.name!==documents[entry.source_index].sourceName)
+        throw Error('invalid definition record');
+      for(const point of [entry.source.begin,entry.source.end]){
+        if(!point || !integer(point.offset) || !Number.isSafeInteger(point.line) || point.line<1 ||
+          !Number.isSafeInteger(point.column) || point.column<1)throw Error('invalid source position');
+        targets[entry.source_index].add(point.offset);
+      }
+      if(entry.source.end.offset<entry.source.begin.offset)throw Error('reversed definition range');
+    });
+    const maps=documents.map((item,index)=>positions(item.source,item.content,targets[index]));
+    const depths=new Map();
+    for(let index=0;index<definitions.length;index++){
+      const trail=[],seen=new Set();let next=index;
+      while(next!==null && !depths.has(next)){
+        if(seen.has(next))throw Error('cyclic definition parents');
+        seen.add(next);trail.push(next);next=definitions[next].parent_function;
+      }
+      let depth=next===null ? -1 : depths.get(next);
+      while(trail.length)depths.set(trail.pop(),++depth);
+    }
+    return definitions.map(entry=>{
+      const begin=maps[entry.source_index].get(entry.source.begin.offset),end=maps[entry.source_index].get(entry.source.end.offset);
+      for(const [actual,expected] of [[begin,entry.source.begin],[end,entry.source.end]])
+        if(actual.line!==expected.line || actual.column!==expected.column)throw Error('source position units disagree');
+      const parent=entry.parent_function===null ? null : definitions[entry.parent_function];
+      if(parent && parent.source_index===entry.source_index &&
+        (parent.source.begin.offset>entry.source.begin.offset || parent.source.end.offset<entry.source.end.offset))
+        throw Error('parent does not contain definition');
+      return {index:entry.index,name:entry.name,kind:entry.kind,className:entry.class_name,
+        declarationOnly:entry.declaration_only,parent:entry.parent_function,depth:depths.get(entry.index),
+        document:documents[entry.source_index],range:{start:begin.editor,end:end.editor,line:begin.line},
+        sourceName:entry.source.name};
+    });
+  }
+  return {read};
+})();
