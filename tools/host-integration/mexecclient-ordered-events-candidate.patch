diff --git a/web/js/ordered-events.js b/web/js/ordered-events.js
new file mode 100644
index 0000000..d5efff8
--- /dev/null
+++ b/web/js/ordered-events.js
@@ -0,0 +1,68 @@
+window.MExec = window.MExec || {};
+
+MExec.orderedEvents = (() => {
+  let supported = false;
+  const control = () => document.querySelector('#ordered-events-enabled');
+  function configure(info) {
+    supported = Array.isArray(info?.features) && info.features.includes('ordered-display-events');
+    const input = control();
+    if (!input) return;
+    input.disabled = !supported;
+    if (!supported) input.checked = false;
+    input.closest('label').hidden = !supported;
+  }
+  function requestOptions() {
+    return supported && control()?.checked
+      ? {include_execution_events:true, max_execution_events:4096} : null;
+  }
+  const decimal = value => typeof value === 'string' && /^(0|[1-9][0-9]{0,19})$/.test(value)
+    && BigInt(value) <= 18446744073709551615n;
+  function validate(data) {
+    if (data.schema !== 'mexec.execution-events' || data.version !== 1 ||
+        data.offset_unit !== 'utf8-byte' || data.column_unit !== 'utf8-byte' ||
+        data.line_base !== 1 || data.column_base !== 1 || data.end_exclusive !== true ||
+        !data.summary || data.summary.enabled !== true || typeof data.summary.started !== 'boolean' ||
+        typeof data.summary.truncated !== 'boolean' || !Array.isArray(data.events) || data.events.length > 4096)
+      return false;
+    const summary = data.summary;
+    if (![summary.generated_count,summary.retained_count,summary.retained_bytes].every(decimal) ||
+        summary.retained_count !== String(data.events.length) ||
+        BigInt(summary.generated_count) < BigInt(summary.retained_count) ||
+        !['none','event-count','byte-limit'].includes(summary.truncation_reason) ||
+        summary.truncated !== (summary.truncation_reason !== 'none') ||
+        (!summary.truncated && summary.generated_count !== summary.retained_count) ||
+        (!summary.started && data.events.length)) return false;
+    return data.events.every((event,index) => event && event.sequence === String(index) &&
+      ['assignment','expression','text','warning','error'].includes(event.kind) &&
+      ['visible','raised','caught','suppressed','unhandled'].includes(event.disposition) &&
+      Number.isSafeInteger(event.capture_depth) && event.capture_depth >= 0 &&
+      typeof event.output_suppressed === 'boolean' && typeof event.label === 'string' &&
+      typeof event.text === 'string' && ['compact','loose'].includes(event.line_spacing) &&
+      (event.value_unavailable === null || typeof event.value_unavailable === 'string') &&
+      (!['warning','error'].includes(event.kind) ||
+        (event.diagnostic && typeof event.diagnostic.message === 'string')));
+  }
+  function render(data, printDiagnostic) {
+    if (data === undefined || data === null) return null;
+    if (!validate(data)) {
+      MExec.command.print('无法读取内核有序回显：不支持或不完整的事件协议', 'warn');
+      return {valid:false, aggregateDiagnostics:true};
+    }
+    for (const event of data.events) {
+      if (event.capture_depth !== 0 || event.output_suppressed ||
+          !['visible','unhandled'].includes(event.disposition)) continue;
+      if (event.kind === 'text') MExec.command.writeOutput(event.text);
+      else if (event.kind === 'warning' || event.kind === 'error') printDiagnostic(event.diagnostic);
+      else {
+        const value = event.value_unavailable === null ? event.text : `[值不可用: ${event.value_unavailable}]`;
+        MExec.command.print(`${event.label} =\n${value}${event.line_spacing === 'loose' ? '\n' : ''}`, 'out');
+      }
+    }
+    if (data.summary.truncated) {
+      MExec.command.print(`内核回显不完整（${data.summary.truncation_reason}，保留 ${data.summary.retained_count}/${data.summary.generated_count} 条）`, 'warn');
+      MExec.command.print('以下执行诊断不属于已保留的回显前缀', 'dim');
+    }
+    return {valid:true, aggregateDiagnostics:!data.summary.started || data.summary.truncated};
+  }
+  return {configure, requestOptions, render};
+})();
