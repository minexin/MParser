+#if MEXEC_GRAPHICS_LAYOUT_ENVIRONMENT
+std::optional<nlohmann::json> WorkspaceSession::graphicsLayoutSnapshot() const {
+    std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+    if (!lock.owns_lock() || executionRunning()) return std::nullopt;
+    return nlohmann::json{{"graphics",nlohmann::json::parse(runtime_.graphicsJson(4))},
+        {"revision",std::to_string(workspaceRevision_)}};
+}
+
+std::optional<nlohmann::json> WorkspaceSession::setGraphicsLayoutEnvironment(
+    const std::string& graph, const std::string& figure,
+    const mparser::sdk::GraphicsLayoutEnvironment& environment, std::uint64_t expectedRevision) {
+    std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+    if (!lock.owns_lock() || executionRunning()) return std::nullopt;
+    if (expectedRevision != workspaceRevision_)
+        return nlohmann::json{{"conflict",true},{"revision",std::to_string(workspaceRevision_)}};
+    if (workspaceRevision_ == std::numeric_limits<std::uint64_t>::max())
+        return nlohmann::json{{"exhausted",true}};
+    runtime_.setGraphicsLayoutEnvironment(graph,figure,environment);
+    ++workspaceRevision_;
+    lastGraphicsJson_ = runtime_.graphicsJson(3);
+    recordActivity();
+    return nlohmann::json{{"graphics",nlohmann::json::parse(runtime_.graphicsJson(4))},
+        {"revision",std::to_string(workspaceRevision_)}};
+}
+#endif
