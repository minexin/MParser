@@ -1699,1 +1699,19 @@
+#if MEXEC_GRAPHICS_WRITEBACK
+std::optional<nlohmann::json> WorkspaceSession::setGraphicsProperty(
+    const std::string& graph, const std::string& object, const std::string& property,
+    const mparser::sdk::Value& value, std::uint64_t expectedRevision) {
+    std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+    if (!lock.owns_lock()) return std::nullopt;
+    if (executionRunning()) return std::nullopt;
+    if (expectedRevision != workspaceRevision_)
+        return nlohmann::json{{"conflict",true},{"revision",std::to_string(workspaceRevision_)}};
+    runtime_.setGraphicsProperty(graph,object,property,value);
+    ++workspaceRevision_;
+    lastGraphicsJson_ = runtime_.graphicsJson(3);
+    recordActivity();
+    return nlohmann::json{{"graphics",nlohmann::json::parse(lastGraphicsJson_)},
+        {"revision",std::to_string(workspaceRevision_)}};
+}
+#endif
