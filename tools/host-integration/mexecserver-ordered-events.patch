diff --git a/include/mexec/engine/execution_event_json.hpp b/include/mexec/engine/execution_event_json.hpp
new file mode 100644
--- /dev/null
+++ b/include/mexec/engine/execution_event_json.hpp
@@ -0,0 +1,55 @@
+#pragma once
+#include "mexec/engine/value_json.hpp"
+#include <stdexcept>
+
+namespace mexec::engine {
+inline nlohmann::json executionEventsToJson(const mparser::sdk::Result& result) {
+    using namespace mparser::sdk;
+    const auto summary = result.eventCaptureSummary();
+    if (!summary.enabled) { return nullptr; }
+    const auto kindName = [](ExecutionEventKind kind) -> const char* {
+        switch (kind) {
+        case ExecutionEventKind::Assignment: return "assignment";
+        case ExecutionEventKind::Expression: return "expression";
+        case ExecutionEventKind::Text: return "text";
+        case ExecutionEventKind::Warning: return "warning";
+        case ExecutionEventKind::Error: return "error";
+        }
+        throw std::logic_error("unsupported kernel event kind");
+    };
+    const auto dispositionName = [](ExecutionEventDisposition value) -> const char* {
+        switch (value) {
+        case ExecutionEventDisposition::Visible: return "visible";
+        case ExecutionEventDisposition::Raised: return "raised";
+        case ExecutionEventDisposition::Caught: return "caught";
+        case ExecutionEventDisposition::Suppressed: return "suppressed";
+        case ExecutionEventDisposition::Unhandled: return "unhandled";
+        }
+        throw std::logic_error("unsupported kernel diagnostic disposition");
+    };
+    const auto position = [](const SourcePosition& value) {
+        return nlohmann::json{{"offset",std::to_string(value.offset)},{"line",value.line},{"column",value.column}};
+    };
+    auto events = nlohmann::json::array();
+    for (const auto& event : result.executionEvents()) {
+        events.push_back({{"kind",kindName(event.kind)},{"sequence",std::to_string(event.sequence)},
+            {"source_context",std::to_string(event.sourceContext)},{"capture_depth",event.captureDepth},
+            {"disposition",dispositionName(event.disposition)},{"label",event.label},{"text",event.text},
+            {"output_suppressed",event.outputSuppressed},{"line_spacing",event.compact ? "compact" : "loose"},
+            {"source",event.sourceAvailable ? nlohmann::json{{"name",event.source.sourceName},
+                {"begin",position(event.source.begin)},{"end",position(event.source.end)}} : nlohmann::json(nullptr)},
+            {"snapshot",event.valueSnapshotJson.empty() ? nlohmann::json(nullptr) : nlohmann::json::parse(event.valueSnapshotJson)},
+            {"value_failure",static_cast<std::uint32_t>(event.valueFailure)},
+            {"value_unavailable",event.valueUnavailable.empty() ? nlohmann::json(nullptr) : nlohmann::json(event.valueUnavailable)},
+            {"diagnostic",event.diagnostic ? diagnosticsToJson({*event.diagnostic}).at(0) : nlohmann::json(nullptr)}});
+    }
+    const auto reason = summary.truncationReason == EventTruncationReason::None ? "none" :
+        summary.truncationReason == EventTruncationReason::EventCount ? "event-count" : "byte-limit";
+    return {{"schema","mexec.execution-events"},{"version",1},{"offset_unit","utf8-byte"},
+        {"column_unit","utf8-byte"},{"line_base",1},{"column_base",1},{"end_exclusive",true},
+        {"summary",{{"enabled",summary.enabled},{"started",summary.started},{"truncated",summary.truncated},
+            {"truncation_reason",reason},{"generated_count",std::to_string(summary.generatedCount)},
+            {"retained_count",std::to_string(summary.retainedCount)},{"retained_bytes",std::to_string(summary.retainedBytes)}}},
+        {"events",std::move(events)}};
+}
+}
