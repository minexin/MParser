+#if MEXEC_SYSTEM_PATH_SYNC
+std::vector<std::string> WorkspaceSession::compilationSearchPathsLocked(const std::filesystem::path& extra) const {
+    const auto encode = [](const std::filesystem::path& path) {
+        const auto bytes = path.generic_u8string();
+        return std::string(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+    };
+    auto result = systemContext_.searchPaths();
+    result.insert(result.begin(), encode(cwd_.empty() ? sessionStore_.root() : sessionStore_.root() / cwd_));
+    if (!extra.empty()) result.insert(result.begin(), encode(extra));
+    std::vector<std::string> unique;
+    for (auto& entry : result) {
+        if (std::find(unique.begin(), unique.end(), entry) == unique.end()) unique.push_back(std::move(entry));
+    }
+    return unique;
+}
+
+std::vector<std::string> WorkspaceSession::virtualSearchPathsLocked() const {
+    const auto root = std::filesystem::weakly_canonical(sessionStore_.root());
+    std::vector<std::string> result;
+    for (const auto& path : systemContext_.searchPaths()) {
+        std::u8string encoded;
+        encoded.reserve(path.size());
+        for (const auto byte : path) encoded.push_back(static_cast<char8_t>(static_cast<unsigned char>(byte)));
+        const auto relative = std::filesystem::path(encoded).lexically_relative(root);
+        if (relative.empty() || relative.is_absolute() || *relative.begin() == "..") {
+            throw std::runtime_error("kernel path is outside the session root");
+        }
+        const auto bytes = relative == "." ? std::u8string{} : relative.generic_u8string();
+        result.emplace_back(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+    }
+    return result;
+}
+#endif
