     void clearWorkspace();
+    enum class WorkspaceRenameStatus { Renamed, Unchanged, Conflict, NotFound, NameConflict, InvalidName };
+    struct WorkspaceRenameResult {
+        WorkspaceRenameStatus status;
+        std::uint64_t revision;
+        mparser::sdk::VariableNameStatus nameStatus = mparser::sdk::VariableNameStatus::Valid;
+    };
+    // Renames only the binding under the revision lock; the SDK Value is untouched.
+    WorkspaceRenameResult renameWorkspaceValue(
+        const std::string& name, const std::string& newName,
+        std::uint64_t expectedRevision);
