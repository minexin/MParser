diff --git a/src/engine/workspace_session.cpp b/src/engine/workspace_session.cpp
--- a/src/engine/workspace_session.cpp
+++ b/src/engine/workspace_session.cpp
@@ -1444,1 +1444,31 @@
+WorkspaceSession::WorkspaceRenameResult WorkspaceSession::renameWorkspaceValue(
+    const std::string& name, const std::string& newName,
+    std::uint64_t expectedRevision) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    using Status = WorkspaceRenameStatus;
+    if (expectedRevision != workspaceRevision_) {
+        return {Status::Conflict, workspaceRevision_};
+    }
+    const auto nameStatus = mparser::sdk::validateVariableName(newName);
+    if (nameStatus != mparser::sdk::VariableNameStatus::Valid) {
+        return {Status::InvalidName, workspaceRevision_, nameStatus};
+    }
+    const auto source = std::find_if(workspace_.begin(), workspace_.end(),
+        [&](const auto& variable) { return variable.name == name; });
+    if (source == workspace_.end()) {
+        return {Status::NotFound, workspaceRevision_};
+    }
+    if (name == newName) {
+        return {Status::Unchanged, workspaceRevision_};
+    }
+    if (std::any_of(workspace_.begin(), workspace_.end(),
+        [&](const auto& variable) { return variable.name == newName; })) {
+        return {Status::NameConflict, workspaceRevision_};
+    }
+    source->name = newName;
+    ++workspaceRevision_;
+    recordActivity();
+    return {Status::Renamed, workspaceRevision_};
+}
+
